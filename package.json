{
  "name": "swarmauri-com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "tsx generate-sitemaps.ts",
    "dev": "vite --host 0.0.0.0",
    "generate:packages": "node scripts/generate-package-catalog.mjs",
    "prebuild": "tsx generate-sitemaps.ts",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "docker:build": "docker compose build swarmauri-com",
    "dns:plan": "npmctl plan desired-state/dns.yaml --owner swarmauri-com",
    "dns:apply": "npmctl apply desired-state/dns.yaml --owner swarmauri-com",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run",
    "deploy": "docker compose -f docker-compose.yaml up -d --build --force-recreate --no-deps swarmauri-com",
    "dns:doctor": "npmctl dns doctor --provider namecheap",
    "proxy:validate": "npmctl validate desired-state/proxy.yaml",
    "proxy:plan": "npmctl plan desired-state/proxy.yaml --owner swarmauri-com",
    "proxy:apply": "npmctl apply desired-state/proxy.yaml --owner swarmauri-com",
    "proxy:target-check": "node scripts/validate-proxy-target.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@mdwrk/structured-data": "^0.1.11",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
